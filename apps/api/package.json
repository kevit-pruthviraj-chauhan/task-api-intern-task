{
	"name": "@task/api",
	"version": "1.0.0",
	"description": "Task Management API built with Express, TypeScript and MongoDB",
	"main": "dist/server.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/server.js",
		"dev": "nodemon --watch src -e ts --exec \"ts-node src/server.ts\"",
		"seed": "ts-node src/seed.ts",
		"lint": "eslint \"src/**/*.ts\"",
		"lint:fix": "eslint \"src/**/*.ts\" --fix",
		"format": "prettier --write \"src/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\""
	},
	"dependencies": {
		"cors": "^2.8.6",
		"dotenv": "^18.0.2",
		"express": "^5.2.1",
		"joi": "^18.2.9",
		"mongoose": "^9.10.1",
		"swagger-ui-express": "^5.0.1",
		"validator": "^13.15.35",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.2",
		"@types/swagger-ui-express": "^4.1.8",
		"@types/validator": "^13.15.10",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"nodemon": "^3.1.14",
		"prettier": "^3.9.8",
		"ts-node": "^10.9.2",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.70.1"
	}
}
