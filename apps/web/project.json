{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn workspace @task/web dev"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn workspace @task/web build"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn workspace @task/web lint"
      }
    }
  }
}
